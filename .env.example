# GhostShell Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Local Ollama service endpoint (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configured Ollama model tag (default: gemma3:4b)
# To use Gemma 3 4B: run `ollama pull gemma3:4b`
OLLAMA_MODEL=gemma3:4b

# Maximum characters allowed for repository inspection context
GHOSTSHELL_MAX_CONTEXT_CHARS=12000

# Network timeouts for local Ollama communication (in seconds)
GHOSTSHELL_CONNECT_TIMEOUT=5.0
GHOSTSHELL_READ_TIMEOUT=90.0

# Authorized project root directory for read-only inspection.
# If left empty, defaults to the parent folder of the GhostShell workspace.
# All paths submitted to /api/inspect must resolve strictly inside this root.
GHOSTSHELL_AUTHORIZED_ROOT=

# Server host and port
HOST=127.0.0.1
PORT=8000

# Automated Test / Offline Demo Mock Mode (DO NOT set to true in production!)
# Set to 'true' only to simulate Ollama responses during isolated test runs.
GHOSTSHELL_MOCK_MODE=false
